{
	"schemaVersion": 1,
	"id": "redfx",
	"version": "${version}",
	"name": "RedFX",
	"description": "A blood particle and visual effects mod.",
	"authors": [
		"Drinfonty"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/redfx-blood-particle"
	},
	"license": "CC0-1.0",
	"icon": "assets/redfx/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.drinfonty.redfx.fabric.RedfxFabric"
		],
		"client": [
			"com.drinfonty.redfx.fabric.RedfxFabricClient"
		],
		"modmenu": [
			"com.drinfonty.redfx.client.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		"redfx.mixins.json",
		{
			"config": "redfx.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "${fabricLoaderDependency}",
		"minecraft": "${minecraftDependency}",
		"java": ">=${javaVersion}",
		"fabric-api": "*"
	}
}
